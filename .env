# OpenAI API 配置
OPENAI_API_KEY=sk-tqqnjzrodogttmeqovwcrpwfqplligiilydlqtaekuerexkm
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 模型配置 - 使用更强的模型以获得更好的视觉还原效果
# 推荐: Qwen/Qwen2.5-72B-Instruct (更强的理解和生成能力)
# 或: deepseek-ai/DeepSeek-V3 (如果支持)
OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# 浏览器配置
HEADLESS=false
WAIT_TIME=15

# 生成配置
MAX_TOKENS=16000
OUTPUT_DIR=output

# LangChain 配置
USE_LANGCHAIN=true
