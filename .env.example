# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
OPENAI_MODEL=gpt-4o

# 浏览器配置
HEADLESS=true
WAIT_TIME=5

# 生成配置
MAX_TOKENS=16000
OUTPUT_DIR=output

# LangChain 配置
USE_LANGCHAIN=true

# 截图配置
# 是否为 URL 自动截图（true/false）
# 设置为 true 时，访问 URL 会自动截图并发送给 LLM 进行视觉分析
# 设置为 false 时，只提取 HTML 结构和文本内容
AUTO_SCREENSHOT=true
