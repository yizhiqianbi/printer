# OpenAI-compatible API 配置
# OpenRouter + Kimi K2.6:
# Either name works. OPENAI_API_KEY is preferred; OPEN_ROUTER_API is kept for local compatibility.
OPENAI_API_KEY=your_openrouter_api_key_here
OPEN_ROUTER_API=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 模型配置
OPENAI_MODEL=moonshotai/kimi-k2.6
OPENAI_REMIX_MODEL=moonshotai/kimi-k2.6
# OpenRouter 推荐的可选标识头。
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
OPENROUTER_X_TITLE=Printer Remix Harness

# 语音转录通常需要单独支持 /audio/transcriptions 的端点。
# 不配置时会沿用 OPENAI_API_KEY / OPENAI_BASE_URL；若 OpenRouter 不支持音频转录，请单独配置这里。
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 浏览器配置
HEADLESS=true
WAIT_TIME=5

# 生成配置
MAX_TOKENS=16000
OUTPUT_DIR=output

# LangChain 配置
USE_LANGCHAIN=true

# 截图配置
# 是否为 URL 自动截图（true/false）
# 设置为 true 时，访问 URL 会自动截图并发送给 LLM 进行视觉分析
# 设置为 false 时，只提取 HTML 结构和文本内容
AUTO_SCREENSHOT=true
